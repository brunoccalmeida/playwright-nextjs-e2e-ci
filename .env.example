# Local-only values that work out of the box with compose.yaml.
# Never reuse them outside a disposable local environment.

# Postgres connection string (see compose.yaml)
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/payload

# Used to encrypt JWT tokens
PAYLOAD_SECRET=local-only-payload-secret-not-for-production

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=local-only-cron-secret-not-for-production

# Used to validate preview requests
PREVIEW_SECRET=local-only-preview-secret-not-for-production

# Admin that the E2E suite logs in as: the demo author created by the seed
E2E_ADMIN_EMAIL=demo-author@example.com
E2E_ADMIN_PASSWORD=password
