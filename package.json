{
  "name": "playwright-nextjs-e2e-ci",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_ENV=production NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=config/playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p config/tsconfig.suite.json",
    "lint:suite": "eslint --config config/eslint.suite.config.mjs --max-warnings=0 config scripts tests",
    "format": "prettier --write .claude .github config scripts .gitlab-ci.yml compose.yaml CLAUDE.md pnpm-workspace.yaml \"tests/**\" \"!tests/e2e/admin.e2e.spec.ts\" \"!tests/e2e/frontend.e2e.spec.ts\" \"!tests/helpers/login.ts\" \"!tests/helpers/seedUser.ts\" \"!tests/int/api.int.spec.ts\"",
    "format:check": "prettier --check .claude .github config scripts .gitlab-ci.yml compose.yaml CLAUDE.md pnpm-workspace.yaml \"tests/**\" \"!tests/e2e/admin.e2e.spec.ts\" \"!tests/e2e/frontend.e2e.spec.ts\" \"!tests/helpers/login.ts\" \"!tests/helpers/seedUser.ts\" \"!tests/int/api.int.spec.ts\"",
    "env:check": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/check-env.ts",
    "db:up": "docker compose -f compose.yaml up -d --wait",
    "db:down": "docker compose -f compose.yaml down -v",
    "db:migrate": "pnpm run env:check && cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:seed": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "check:known-issues": "tsx scripts/check-known-issues.ts",
    "check:agent-rules": "tsx scripts/check-agent-rules.ts",
    "check:ci-image": "tsx scripts/check-ci-image.ts",
    "check:readme": "tsx scripts/check-readme-numbers.ts",
    "check": "pnpm run typecheck && pnpm run lint:suite && pnpm run format:check && pnpm run check:known-issues && pnpm run check:agent-rules && pnpm run check:ci-image && pnpm run check:readme"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.93.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-nested-docs": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-search": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "next": "16.4.4",
    "next-sitemap": "^4.2.3",
    "payload": "3.93.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.3",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-playwright": "2.12.2",
    "jsdom": "28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@11.28.9"
}
