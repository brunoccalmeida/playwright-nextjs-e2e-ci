{
  // Stricter checks for the code this repository owns. The template's
  // tsconfig.json stays as generated and still type-checks everything.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  },
  "include": ["../config/**/*.ts", "../scripts/**/*.ts", "../tests/**/*.ts"],
  // Generated by the template and left untouched
  "exclude": [
    "../tests/e2e/admin.e2e.spec.ts",
    "../tests/e2e/frontend.e2e.spec.ts",
    "../tests/helpers/login.ts",
    "../tests/helpers/seedUser.ts",
    "../tests/int/api.int.spec.ts",
    // Imports the app's config and seed, which pulls src/ into this stricter
    // program. It stays covered by the template's tsconfig.json.
    "../scripts/seed.ts"
  ]
}
